# Движение захвата в заданную позу.
#
# Поза задаётся для точки TCP — точки на оси захвата между подушечками пальцев
# (кадр tcp описания робота): ось z направлена от захвата, пальцы сжимаются вдоль оси y.
# Новый goal вытесняет исполняемый: тот завершается со статусом ABORTED.

uint8 JOINT=0                   # интерполяция углов суставов, путь захвата криволинейный
uint8 LINEAR=1                  # прямолинейное движение захвата

geometry_msgs/Pose target       # поза TCP в системе основания манипулятора
uint8 motion_type               # JOINT или LINEAR
---
bool success
string message                  # причина неудачи
---
float64 distance_to_target      # расстояние от TCP до цели, м
