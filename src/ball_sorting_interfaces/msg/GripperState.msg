# Состояние захвата в терминах задачи.

uint8 OPEN=0                    # раскрыт
uint8 MOVING=1                  # выполняется команда сжатия или раскрытия
uint8 HOLDING=2                 # сжат и удерживает объект
uint8 CLOSED_EMPTY=3            # сжат без объекта: не схватил или потерял

std_msgs/Header header          # stamp — время, когда состояние вычислено
uint8 state
